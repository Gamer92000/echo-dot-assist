# Home Assistant satellite instead of Alexa.  Appended to the boot ramdisk's init.rook.rc by scripts/mkbootroot.py (device.conf
# RAMDISK_RC): Android 5.1's init reads rc files from the ramdisk only.  Both services do nothing unless
# /data/local/hassmic/hassmic.conf exists; without it boot.sh also turns Alexa's apps back on if alexa-off.sh had turned them
# off.  seclabel su: permissive in rook's stock policy; the boot image's policy lets init into it (sepolicy.rules).

service hassmic_fw /system/bin/sh /system/hassmic/boot.sh firewall
    class main
    user root
    seclabel u:r:su:s0
    disabled
    oneshot

service hassmic /system/bin/sh /system/hassmic/boot.sh satellite
    class main
    user root
    seclabel u:r:su:s0
    disabled
    oneshot

on boot
    start hassmic_fw

# Alexa on rook is Android apps, started by the framework: no init trigger to follow as on the Dots.  alexa-off.sh
# disables them with pm, which needs the package manager up; boot_completed is when it is.
on property:sys.boot_completed=1
    start hassmic
