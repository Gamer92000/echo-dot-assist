# Cannoli NS6575 / 8349. Policy is patched in the SquashFS image by the builder.
# Run after the imported stock USB actions: mt851x otherwise enables TCP 5555.
# Keep the root transport on USB and override a saved stock 'none' setting.
on boot
    setprop service.adb.tcp.port -1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on post-fs-data
    exec u:r:su:s0 root root -- /system/bin/sh /system/hassmic/prepare.sh

service hassmic_fw /system/bin/sh /system/hassmic/boot.sh firewall
    class main
    user root
    seclabel u:r:su:s0
    disabled
    oneshot

service hassmic /system/bin/sh /system/hassmic/boot.sh satellite
    class main
    user root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:hassmic.storage.ready=1
    start hassmic_fw

# prepare.sh and the firewall service clear PUFFIN_START to suppress Alexa.
# Waiting for that flag can miss the LED controller's one-time startup event.
# The satellite needs the mounted overlay and mixer, not Alexa's launch flag.
on property:hassmic.storage.ready=1 && property:audio_mixer.init=true
    start hassmic
