{ "id": "testmusic", "name": "Test player", "version": 1, "version_name": "0.1", "requires": {"core": 1, "audio.music": 1, "audio.volume": 1, "state": 1, "net.udp": 1, "net.discover": 1, "net.server": 1, "ha.entities": 1, "ha.actions": 1},
  "author": "hassmic's tests", "description": "Plays a tone, as a music player would.", "license": "MIT",
  "memory_mb": 16, "threads": 2,
  "capabilities": { "audio.music": true, "audio.volume": true, "state": true, "net.udp": 1,
                    "net.discover": { "udp": 16997, "to": "broadcast" },
                    "net.server": [ { "setting": "server", "proto": "tcp", "ports": [ 16996 ] } ],
                    "ha.entities": [ { "name": "position", "kind": "sensor", "label": "Position", "unit": "s", "icon": "mdi:timer" },
                                     { "name": "volume", "kind": "sensor", "label": "Volume", "unit": "%" },
                                     { "name": "assistant", "kind": "text_sensor", "label": "Assistant" },
                                     { "name": "loud", "kind": "switch", "label": "Loud" },
                                     { "name": "level", "kind": "number", "label": "Level", "min": 0, "max": 10, "step": 1 },
                                     { "name": "mode", "kind": "select", "label": "Mode", "options": [ "tone", "noise" ] },
                                     { "name": "ping", "kind": "button", "label": "Ping" },
                                     { "name": "pressed", "kind": "event", "label": "Pressed", "types": [ "ping", "pong" ] } ],
                    "ha.actions": [ { "name": "search", "label": "Search for the server", "page": true },
                                    { "name": "set_volume", "label": "Set the volume", "args": [ { "name": "percent", "type": "int" } ] },
                                    { "name": "try", "label": "Try", "args": [ { "name": "what", "type": "string" } ] } ] },
  "settings": [
    { "name": "server", "label": "Player server", "type": "host", "help": "Found by the search, or typed." },
    { "name": "mode", "label": "Mode", "type": "select", "options": [ "tone" ], "default": "tone" } ] }
