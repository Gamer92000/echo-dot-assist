<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Lets Home Assistant discover the satellite.  Goes to /data/misc/avahi/services/, the stock avahi-daemon's static dir. -->
<service-group>
  <name replace-wildcards="yes">Echo Dot %h</name>
  <service>
    <type>_wyoming._tcp</type>
    <port>16700</port>
  </service>
</service-group>
